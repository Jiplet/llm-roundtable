# Copy this file to .env and fill in whichever providers you actually use.
# roundtable reads .env from the current directory on startup; it never writes to it.

# Anthropic (Claude models)
ANTHROPIC_API_KEY=sk-ant-your.key.here

# OpenAI
OPENAI_API_KEY=sk-your.key.here

# OpenRouter (one key, many providers, OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your.key.here

# Ollama (local models, no key needed). Only set this if your Ollama server
# is not on the default address.
OLLAMA_HOST=http://localhost:11434
